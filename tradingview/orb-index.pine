//@version=6
// Index (NQ/ES) — ORB/IB + Objective Levels
//
// Companion to the local sim (see ../CONTEXT.md, ../docs/adr/0009-*, 0010-*, 0012-*). One of
// two per-instrument indicators (the other is orb-gold.pine, ADR-0010): this file carries
// the index-session catalog — NY 15m + 30m opening ranges, the Initial Balance, the
// Pre-Tokyo range (18:00–20:00 ET accumulation window frozen at the Tokyo open — the
// Asia-evening sweep levels, ADR-0012; not an opening range, nothing is traded at 18:00),
// prior-session VAH/VAL/POC auto-computed over the prior NY RTH session (09:30–16:00 ET —
// overnight volume is too thin to move the index profile, ADR-0012), session VWAPs, and
// period/session H/L. No VRVP (use TradingView's native visible-range Volume Profile)
// and no ad-hoc AVWAP (use the built-in Anchored VWAP drawing tool).
//
// ORB anatomy (ADR-0010, shared by the Pre-Tokyo range): high/low/midpoint lines, each
// toggleable, role-styled (solid high / dashed low / dotted mid by default), with an
// optional transparent shaded box. Lines and shading are WINDOWED — they start at the
// window open and extend right until the session span ends — never full-chart-width. The
// IB block keeps its original anatomy (extend.both lines, retracements/extensions at
// freeze), per the user's call. Period H/L scope follows market convention (full ETH day,
// calendar week/month) — the sim's answer key deliberately differs (ADR-0009).
indicator("Index ORB/IB + Levels", overlay = true, max_lines_count = 480,
     max_labels_count = 480, max_boxes_count = 30)

// ── Display ─────────────────────────────────────────────────────────────────────────
showLabels   = input.bool(true, "Show price labels", group = "Display")
labelSizeIn  = input.string("Small", "Label size (all labels)", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = "Display")
htfThreshold = input.timeframe("30", "Hide intraday groups above this timeframe",
     group = "Display", tooltip = "Session H/L and the NY session VWAP auto-hide above this chart timeframe. Period H/L, prior-session VAH/VAL/POC, and Daily/Weekly VWAP always show; ORB/IB/PT windows simply don't form on TFs above their own length.")
isIntraday   = timeframe.in_seconds() <= timeframe.in_seconds(htfThreshold)
highStyle    = input.string("Solid", "High-line style", options = ["Solid", "Dashed", "Dotted"], group = "Display")
lowStyle     = input.string("Dashed", "Low-line style", options = ["Solid", "Dashed", "Dotted"], group = "Display")
midStyle     = input.string("Dotted", "Midpoint-line style", options = ["Solid", "Dashed", "Dotted"], group = "Display")
devDotted    = input.bool(true, "OR/IB/PT: dotted while developing", group = "Display",
     tooltip = "While the OR, IB, or Pre-Tokyo window is still forming, show dotted regardless of the role styles above; once frozen, switch to each line's own style.")

// ── Opening Range 15m ───────────────────────────────────────────────────────────────
show15        = input.bool(true, "Show 15m Opening Range", group = "Opening Range 15m")
or15ShowHi    = input.bool(true, "High line", group = "Opening Range 15m", inline = "or15lines")
or15ShowLo    = input.bool(true, "Low", group = "Opening Range 15m", inline = "or15lines")
or15ShowMid   = input.bool(true, "Midpoint", group = "Opening Range 15m", inline = "or15lines")
or15Color     = input.color(#38bdf8, "Color", group = "Opening Range 15m")
or15Shade     = input.bool(true, "Shade area", group = "Opening Range 15m")
or15ShadeCol  = input.color(color.new(#38bdf8, 88), "Shade color (opacity slider = transparency)", group = "Opening Range 15m")
or15Window    = input.session("0930-0945", "OR window (start-end, ET)", group = "Opening Range 15m")
or15Span      = input.session("0930-1600", "Draw until (span, ET)", group = "Opening Range 15m",
     tooltip = "Lines/shade start at the OR window open and extend right while inside this span, then freeze.")
orLabelOffset = input.int(0, "ORB label offset (bars back)", group = "Opening Range 15m",
     tooltip = "How far back along the line the price tags sit for BOTH ORB groups; the 30m ORB staggers further back automatically. 0 = right at the live edge.")

// ── Opening Range 30m ───────────────────────────────────────────────────────────────
show30        = input.bool(true, "Show 30m Opening Range", group = "Opening Range 30m")
or30ShowHi    = input.bool(true, "High line", group = "Opening Range 30m", inline = "or30lines")
or30ShowLo    = input.bool(true, "Low", group = "Opening Range 30m", inline = "or30lines")
or30ShowMid   = input.bool(false, "Midpoint", group = "Opening Range 30m", inline = "or30lines")
or30Color     = input.color(#818cf8, "Color", group = "Opening Range 30m")
or30Shade     = input.bool(false, "Shade area", group = "Opening Range 30m")
or30ShadeCol  = input.color(color.new(#818cf8, 90), "Shade color (opacity slider = transparency)", group = "Opening Range 30m")
or30Window    = input.session("0930-1000", "OR30 window (start-end, ET)", group = "Opening Range 30m")
or30Span      = input.session("0930-1600", "Draw until (span, ET)", group = "Opening Range 30m")

// ── Initial Balance (anatomy unchanged — ADR-0010) ──────────────────────────────────
showIbRange   = input.bool(true, "Show IB high/low", group = "Initial Balance")
showIbRetrace = input.bool(true, "Show IB retracements (25/50/75%)", group = "Initial Balance")
showIbExt     = input.bool(false, "Show IB extensions", group = "Initial Balance")
ibHighColor   = input.color(#fb923c, "IB High color", group = "Initial Balance")
ibLowColor    = input.color(#fb923c, "IB Low color", group = "Initial Balance")
ibColor       = input.color(#fb923c, "IB retracement/extension color", group = "Initial Balance")
ibWindow      = input.session("0930-1030", "IB window (start-end, ET)", group = "Initial Balance")
ibExt1        = input.float(0.5, "Extension 1 (x IB range)", group = "Initial Balance")
ibExt2        = input.float(1.0, "Extension 2 (x IB range)", group = "Initial Balance")
ibLabelOffset = input.int(-2, "IB label offset (bars back)", group = "Initial Balance",
     tooltip = "How far back along the line the H/L tags sit; retracements and extensions stagger further back automatically.")

// ── Pre-Tokyo range (Globex open 18:00 → Tokyo open 20:00 ET — ADR-0012) ────────────
showPt      = input.bool(true, "Show Pre-Tokyo range (18:00–20:00)", group = "Pre-Tokyo range",
     tooltip = "The Globex-open-to-Tokyo-open accumulation window; freezes at the 20:00 ET Tokyo open and its H/L are the Asia-evening sweep levels (ADR-0012). Not an opening range — nothing is traded at 18:00. Fires every Globex open including Sunday's.")
ptShowHi    = input.bool(true, "High line", group = "Pre-Tokyo range", inline = "ptlines")
ptShowLo    = input.bool(true, "Low", group = "Pre-Tokyo range", inline = "ptlines")
ptShowMid   = input.bool(false, "Midpoint", group = "Pre-Tokyo range", inline = "ptlines")
ptColor     = input.color(#facc15, "Color", group = "Pre-Tokyo range")
ptShade     = input.bool(true, "Shade area", group = "Pre-Tokyo range")
ptShadeCol  = input.color(color.new(#facc15, 85), "Shade color (opacity slider = transparency)", group = "Pre-Tokyo range")
ptWindow    = input.session("1800-2000", "Range window (start-end, ET)", group = "Pre-Tokyo range")
ptSpan      = input.session("1800-0300", "Draw until (span, ET)", group = "Pre-Tokyo range")

// ── VWAP ─────────────────────────────────────────────────────────────────────────────
showVwapNy      = input.bool(true, "Show NY session VWAP", group = "VWAP")
nyVwapSession   = input.session("0930-1600", "NY VWAP window (ET)", group = "VWAP")
vwapNyColor     = input.color(#22d3ee, "NY session color", group = "VWAP")
showVwapDaily   = input.bool(true, "Show daily VWAP (Globex 18:00 ET open)", group = "VWAP")
vwapDailyColor  = input.color(#2dd4bf, "Daily color", group = "VWAP")
showVwapWeekly  = input.bool(false, "Show weekly VWAP (Sun 18:00 ET open)", group = "VWAP")
vwapWeeklyColor = input.color(#a78bfa, "Weekly color", group = "VWAP")

// ── Period H/L (full ETH day, calendar week/month — market convention, ADR-0009) ────
showPdhl = input.bool(true, "Show prior-day H/L (PDH/PDL)", group = "Period H/L")
pdhColor = input.color(#f59e0b, "PDH color", group = "Period H/L")
pdlColor = input.color(#f59e0b, "PDL color", group = "Period H/L")
showPwhl = input.bool(true, "Show prior-week H/L", group = "Period H/L")
pwhColor = input.color(#f59e0b, "Prior-week H color", group = "Period H/L")
pwlColor = input.color(#f59e0b, "Prior-week L color", group = "Period H/L")
showPmhl = input.bool(false, "Show prior-month H/L", group = "Period H/L")
pmhColor = input.color(#f59e0b, "Prior-month H color", group = "Period H/L")
pmlColor = input.color(#f59e0b, "Prior-month L color", group = "Period H/L")
periodLabelOffset = input.int(-5, "Period label offset (bars back)", group = "Period H/L",
     tooltip = "How far back along the line the PD tag sits; PW and PM stagger further back automatically.")

// ── Value Area (prior-session VAH/VAL/POC — ADR-0012) ───────────────────────────────
showVa     = input.bool(true, "Show prior-session VAH/VAL/POC", group = "Value Area",
     tooltip = "Auto-computed volume profile of the prior session. Index scopes to the prior NY RTH session (09:30–16:00 ET) — overnight volume is too thin to move the profile (ADR-0012). Values freeze at the 16:00 close and hold until the next close, so they serve both the Asia evening and the next NY morning; Friday's carry through Sunday evening. Within a few ticks of the native fixed-range VP, not tick-exact.")
vaShowVah  = input.bool(true, "VAH", group = "Value Area", inline = "valines")
vaShowVal  = input.bool(true, "VAL", group = "Value Area", inline = "valines")
vaShowPoc  = input.bool(true, "POC", group = "Value Area", inline = "valines")
vaWindow   = input.session("0930-1600", "Profile session (ET)", group = "Value Area")
vaPct      = input.float(70, "Value area (% of session volume)", minval = 10, maxval = 100, step = 5, group = "Value Area")
vaBinTicks = input.int(10, "Bin size (ticks)", minval = 1, group = "Value Area",
     tooltip = "Histogram resolution: each bin spans this many ticks. Smaller = finer POC placement, more compute.")
vahColor   = input.color(#e879f9, "VAH color", group = "Value Area")
valColor   = input.color(#e879f9, "VAL color", group = "Value Area")
pocColor   = input.color(#d946ef, "POC color", group = "Value Area")
vaLabelOffset = input.int(-4, "VA label offset (bars back)", group = "Value Area",
     tooltip = "How far back along the line the VAH/VAL tags sit; POC staggers further back automatically.")

// ── Session H/L (Asia/London/Overnight — windows shared with the sim) ──────────────
showOn          = input.bool(true, "Show Overnight H/L", group = "Session H/L")
onWindow        = input.session("1800-0930", "Overnight window (ET)", group = "Session H/L")
onHighColor     = input.color(#10b981, "Overnight High color", group = "Session H/L")
onLowColor      = input.color(#10b981, "Overnight Low color", group = "Session H/L")
showAsia        = input.bool(true, "Show Asia H/L", group = "Session H/L")
asiaWindow      = input.session("1800-0300", "Asia window (ET)", group = "Session H/L")
asiaHighColor   = input.color(#10b981, "Asia High color", group = "Session H/L")
asiaLowColor    = input.color(#10b981, "Asia Low color", group = "Session H/L")
showLondon      = input.bool(true, "Show London H/L", group = "Session H/L")
londonWindow    = input.session("0300-0930", "London window (ET)", group = "Session H/L")
londonHighColor = input.color(#10b981, "London High color", group = "Session H/L")
londonLowColor  = input.color(#10b981, "London Low color", group = "Session H/L")
sessionLabelOffset = input.int(-8, "Session label offset (bars back)", group = "Session H/L",
     tooltip = "How far back along the line the Overnight tag sits; Asia and London stagger further back automatically.")

// ── Helpers ──────────────────────────────────────────────────────────────────────────
styleFromStr(s) =>
    switch s
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

resolveStyle(baseStr, developing) =>
    developing and devDotted ? line.style_dotted : styleFromStr(baseStr)

sizeFromStr(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        => size.small

labelSize = sizeFromStr(labelSizeIn)

etTz = "America/New_York"
dayKey = year(time, etTz) * 10000 + month(time, etTz) * 100 + dayofmonth(time, etTz)

// ═══════════════════════════════════════════════════════════════════════════════════
// Windowed ranges — one generic renderer (ADR-0010) shared by the NY ORBs and the
// Pre-Tokyo range (ADR-0012). Lines and shade start at the window open and extend right
// while inside the span, then freeze; each new window deletes the previous day's
// objects. H/L/mid individually toggleable; styles come from the global role inputs
// (dotted while the window is still forming). The ":1234567" day filter includes Sunday
// so the Pre-Tokyo range fires on the Sunday 18:00 ET Globex open.
// ═══════════════════════════════════════════════════════════════════════════════════
drawOrb(active, windowStr, spanStr, lbl, showHi, showLo, showMid, col, shade, shadeCol, xOffset) =>
    var float hi = na
    var float lo = na
    var line hiLine = na
    var line loLine = na
    var line midLine = na
    var box band = na
    var label hiLabel = na
    var label loLabel = na
    var label midLabel = na

    if active
        inWin = not na(time(timeframe.period, windowStr + ":1234567", etTz))
        inSpan = not na(time(timeframe.period, spanStr + ":1234567", etTz))
        newWin = inWin and not inWin[1]

        if newWin
            hi := high
            lo := low
            line.delete(hiLine)
            line.delete(loLine)
            line.delete(midLine)
            box.delete(band)
            label.delete(hiLabel)
            label.delete(loLabel)
            label.delete(midLabel)
            if shade
                band := box.new(bar_index, high, bar_index + 1, low, border_color = color.new(col, 100), bgcolor = shadeCol)
            if showHi
                hiLine := line.new(bar_index, high, bar_index + 1, high, color = col, width = 1)
            if showLo
                loLine := line.new(bar_index, low, bar_index + 1, low, color = col, width = 1)
            if showMid
                midLine := line.new(bar_index, high, bar_index + 1, high, color = col, width = 1)
            if showLabels
                if showHi
                    hiLabel := label.new(bar_index + xOffset, high, lbl + " H", style = label.style_label_left,
                         textcolor = col, color = color.new(color.black, 100), size = labelSize)
                if showLo
                    loLabel := label.new(bar_index + xOffset, low, lbl + " L", style = label.style_label_left,
                         textcolor = col, color = color.new(color.black, 100), size = labelSize)
                if showMid
                    midLabel := label.new(bar_index + xOffset, high, lbl + " M", style = label.style_label_left,
                         textcolor = col, color = color.new(color.black, 100), size = labelSize)
        else if inWin
            hi := math.max(hi, high)
            lo := math.min(lo, low)

        if inSpan and not na(hi)
            mid = (hi + lo) / 2
            if not na(hiLine)
                line.set_y1(hiLine, hi)
                line.set_y2(hiLine, hi)
                line.set_x2(hiLine, bar_index)
                line.set_style(hiLine, resolveStyle(highStyle, inWin))
            if not na(loLine)
                line.set_y1(loLine, lo)
                line.set_y2(loLine, lo)
                line.set_x2(loLine, bar_index)
                line.set_style(loLine, resolveStyle(lowStyle, inWin))
            if not na(midLine)
                line.set_y1(midLine, mid)
                line.set_y2(midLine, mid)
                line.set_x2(midLine, bar_index)
                line.set_style(midLine, resolveStyle(midStyle, inWin))
            if not na(band)
                box.set_top(band, hi)
                box.set_bottom(band, lo)
                box.set_right(band, bar_index)
            if showLabels
                if not na(hiLabel)
                    label.set_xy(hiLabel, bar_index + xOffset, hi)
                    label.set_text(hiLabel, lbl + " H " + str.tostring(hi, format.mintick))
                if not na(loLabel)
                    label.set_xy(loLabel, bar_index + xOffset, lo)
                    label.set_text(loLabel, lbl + " L " + str.tostring(lo, format.mintick))
                if not na(midLabel)
                    label.set_xy(midLabel, bar_index + xOffset, mid)
                    label.set_text(midLabel, lbl + " M " + str.tostring(mid, format.mintick))

drawOrb(show15, or15Window, or15Span, "OR", or15ShowHi, or15ShowLo, or15ShowMid, or15Color, or15Shade, or15ShadeCol, orLabelOffset)
drawOrb(show30, or30Window, or30Span, "OR30", or30ShowHi, or30ShowLo, or30ShowMid, or30Color, or30Shade, or30ShadeCol, orLabelOffset - 2)
drawOrb(showPt, ptWindow, ptSpan, "PT", ptShowHi, ptShowLo, ptShowMid, ptColor, ptShade, ptShadeCol, orLabelOffset - 4)

// ═══════════════════════════════════════════════════════════════════════════════════
// Initial Balance — anatomy unchanged from the original combined file (extend.both
// lines; retracements/extensions created at the 10:30 freeze, ADR-0010).
// ═══════════════════════════════════════════════════════════════════════════════════
if showIbRange or showIbRetrace or showIbExt
    inIB = not na(time(timeframe.period, ibWindow + ":23456", etTz))
    newIB = inIB and not inIB[1]

    var float ibHigh = na
    var float ibLow = na
    var int ibDayKey = na
    var line ibHiLine = na
    var line ibLoLine = na
    var label ibHiLabel = na
    var label ibLoLabel = na
    var line ib25Line = na
    var line ib50Line = na
    var line ib75Line = na
    var label ib25Label = na
    var label ib50Label = na
    var label ib75Label = na
    var line ibExt1UpLine = na
    var line ibExt1DnLine = na
    var line ibExt2UpLine = na
    var line ibExt2DnLine = na
    var label ibExt1UpLabel = na
    var label ibExt1DnLabel = na
    var label ibExt2UpLabel = na
    var label ibExt2DnLabel = na

    if newIB
        ibHigh := high
        ibLow := low
        ibDayKey := dayKey
        line.delete(ibHiLine)
        line.delete(ibLoLine)
        line.delete(ib25Line)
        line.delete(ib50Line)
        line.delete(ib75Line)
        line.delete(ibExt1UpLine)
        line.delete(ibExt1DnLine)
        line.delete(ibExt2UpLine)
        line.delete(ibExt2DnLine)
        label.delete(ibHiLabel)
        label.delete(ibLoLabel)
        label.delete(ib25Label)
        label.delete(ib50Label)
        label.delete(ib75Label)
        label.delete(ibExt1UpLabel)
        label.delete(ibExt1DnLabel)
        label.delete(ibExt2UpLabel)
        label.delete(ibExt2DnLabel)
        ibHiLine := line.new(bar_index - 1, high, bar_index, high, color = ibHighColor, width = 1, extend = extend.both)
        ibLoLine := line.new(bar_index - 1, low, bar_index, low, color = ibLowColor, width = 1, extend = extend.both)
        if showLabels
            ibHiLabel := label.new(bar_index + ibLabelOffset, high, "IB H", style = label.style_label_left,
                 textcolor = ibHighColor, color = color.new(color.black, 100), size = labelSize)
            ibLoLabel := label.new(bar_index + ibLabelOffset, low, "IB L", style = label.style_label_left,
                 textcolor = ibLowColor, color = color.new(color.black, 100), size = labelSize)
    else if inIB
        ibHigh := math.max(ibHigh, high)
        ibLow := math.min(ibLow, low)

    ibComplete = dayKey == ibDayKey and not inIB and not na(ibHiLine)
    newIbComplete = ibComplete and not ibComplete[1]
    ibRange = ibHigh - ibLow
    y25 = ibLow + 0.25 * ibRange
    y50 = ibLow + 0.50 * ibRange
    y75 = ibLow + 0.75 * ibRange
    yExt1Up = ibHigh + ibExt1 * ibRange
    yExt1Dn = ibLow - ibExt1 * ibRange
    yExt2Up = ibHigh + ibExt2 * ibRange
    yExt2Dn = ibLow - ibExt2 * ibRange

    if not na(ibHiLine) and showIbRange
        line.set_y1(ibHiLine, ibHigh)
        line.set_y2(ibHiLine, ibHigh)
        line.set_style(ibHiLine, resolveStyle(highStyle, inIB))
        line.set_y1(ibLoLine, ibLow)
        line.set_y2(ibLoLine, ibLow)
        line.set_style(ibLoLine, resolveStyle(lowStyle, inIB))
        if showLabels
            label.set_xy(ibHiLabel, bar_index + ibLabelOffset, ibHigh)
            label.set_text(ibHiLabel, "IB H " + str.tostring(ibHigh, format.mintick))
            label.set_xy(ibLoLabel, bar_index + ibLabelOffset, ibLow)
            label.set_text(ibLoLabel, "IB L " + str.tostring(ibLow, format.mintick))

    // Retracements/extensions are only known once the IB freezes at 10:30 — create them
    // right then (not at 09:30 with placeholder na values), so they never sit stale at
    // a stray position before they mean anything.
    if newIbComplete and showIbRetrace
        ib25Line := line.new(bar_index - 1, y25, bar_index, y25, color = ibColor, width = 2, style = line.style_dotted, extend = extend.both)
        ib50Line := line.new(bar_index - 1, y50, bar_index, y50, color = ibColor, width = 2, style = line.style_dotted, extend = extend.both)
        ib75Line := line.new(bar_index - 1, y75, bar_index, y75, color = ibColor, width = 2, style = line.style_dotted, extend = extend.both)
        if showLabels
            ib25Label := label.new(bar_index + ibLabelOffset - 1, y25, "IB 25% " + str.tostring(y25, format.mintick), style = label.style_label_left,
                 textcolor = ibColor, color = color.new(color.black, 100), size = labelSize)
            ib50Label := label.new(bar_index + ibLabelOffset - 1, y50, "IB 50% " + str.tostring(y50, format.mintick), style = label.style_label_left,
                 textcolor = ibColor, color = color.new(color.black, 100), size = labelSize)
            ib75Label := label.new(bar_index + ibLabelOffset - 1, y75, "IB 75% " + str.tostring(y75, format.mintick), style = label.style_label_left,
                 textcolor = ibColor, color = color.new(color.black, 100), size = labelSize)

    if not na(ib25Line) and showIbRetrace
        line.set_y1(ib25Line, y25)
        line.set_y2(ib25Line, y25)
        line.set_y1(ib50Line, y50)
        line.set_y2(ib50Line, y50)
        line.set_y1(ib75Line, y75)
        line.set_y2(ib75Line, y75)
        if showLabels
            label.set_xy(ib25Label, bar_index + ibLabelOffset - 1, y25)
            label.set_text(ib25Label, "IB 25% " + str.tostring(y25, format.mintick))
            label.set_xy(ib50Label, bar_index + ibLabelOffset - 1, y50)
            label.set_text(ib50Label, "IB 50% " + str.tostring(y50, format.mintick))
            label.set_xy(ib75Label, bar_index + ibLabelOffset - 1, y75)
            label.set_text(ib75Label, "IB 75% " + str.tostring(y75, format.mintick))

    if newIbComplete and showIbExt
        ibExt1UpLine := line.new(bar_index - 1, yExt1Up, bar_index, yExt1Up, color = ibColor, width = 1, style = line.style_dashed, extend = extend.both)
        ibExt1DnLine := line.new(bar_index - 1, yExt1Dn, bar_index, yExt1Dn, color = ibColor, width = 1, style = line.style_dashed, extend = extend.both)
        ibExt2UpLine := line.new(bar_index - 1, yExt2Up, bar_index, yExt2Up, color = ibColor, width = 1, style = line.style_dashed, extend = extend.both)
        ibExt2DnLine := line.new(bar_index - 1, yExt2Dn, bar_index, yExt2Dn, color = ibColor, width = 1, style = line.style_dashed, extend = extend.both)
        if showLabels
            ibExt1UpLabel := label.new(bar_index + ibLabelOffset - 2, yExt1Up, "IB +" + str.tostring(ibExt1) + " " + str.tostring(yExt1Up, format.mintick),
                 style = label.style_label_left, textcolor = ibColor, color = color.new(color.black, 100), size = labelSize)
            ibExt1DnLabel := label.new(bar_index + ibLabelOffset - 2, yExt1Dn, "IB -" + str.tostring(ibExt1) + " " + str.tostring(yExt1Dn, format.mintick),
                 style = label.style_label_left, textcolor = ibColor, color = color.new(color.black, 100), size = labelSize)
            ibExt2UpLabel := label.new(bar_index + ibLabelOffset - 2, yExt2Up, "IB +" + str.tostring(ibExt2) + " " + str.tostring(yExt2Up, format.mintick),
                 style = label.style_label_left, textcolor = ibColor, color = color.new(color.black, 100), size = labelSize)
            ibExt2DnLabel := label.new(bar_index + ibLabelOffset - 2, yExt2Dn, "IB -" + str.tostring(ibExt2) + " " + str.tostring(yExt2Dn, format.mintick),
                 style = label.style_label_left, textcolor = ibColor, color = color.new(color.black, 100), size = labelSize)

    if not na(ibExt1UpLine) and showIbExt
        line.set_y1(ibExt1UpLine, yExt1Up)
        line.set_y2(ibExt1UpLine, yExt1Up)
        line.set_y1(ibExt1DnLine, yExt1Dn)
        line.set_y2(ibExt1DnLine, yExt1Dn)
        line.set_y1(ibExt2UpLine, yExt2Up)
        line.set_y2(ibExt2UpLine, yExt2Up)
        line.set_y1(ibExt2DnLine, yExt2Dn)
        line.set_y2(ibExt2DnLine, yExt2Dn)
        if showLabels
            label.set_xy(ibExt1UpLabel, bar_index + ibLabelOffset - 2, yExt1Up)
            label.set_text(ibExt1UpLabel, "IB +" + str.tostring(ibExt1) + " " + str.tostring(yExt1Up, format.mintick))
            label.set_xy(ibExt1DnLabel, bar_index + ibLabelOffset - 2, yExt1Dn)
            label.set_text(ibExt1DnLabel, "IB -" + str.tostring(ibExt1) + " " + str.tostring(yExt1Dn, format.mintick))
            label.set_xy(ibExt2UpLabel, bar_index + ibLabelOffset - 2, yExt2Up)
            label.set_text(ibExt2UpLabel, "IB +" + str.tostring(ibExt2) + " " + str.tostring(yExt2Up, format.mintick))
            label.set_xy(ibExt2DnLabel, bar_index + ibLabelOffset - 2, yExt2Dn)
            label.set_text(ibExt2DnLabel, "IB -" + str.tostring(ibExt2) + " " + str.tostring(yExt2Dn, format.mintick))

// ═══════════════════════════════════════════════════════════════════════════════════
// VWAP — three independently toggleable anchors, no bands
// ═══════════════════════════════════════════════════════════════════════════════════
inRth = not na(time(timeframe.period, nyVwapSession + ":23456", etTz))
newRthDay = inRth and not inRth[1]

// Globex day rolls at 18:00 ET. Detecting that via a "true except one minute" window
// breaks here: CME has a ~17:00-18:00 ET maintenance halt with zero prints, so the
// single false bar the old detector needed to see never exists in the data, and the
// reset silently never fires. Instead, compute which Globex day each bar belongs to
// directly (shift the timestamp 6h so 18:00+ rolls onto the next calendar date) and
// reset whenever that key changes between consecutive bars — robust to any gap size,
// maintenance halt or weekend alike.
globexShiftedTime = time + 6 * 60 * 60 * 1000
globexDayKey = year(globexShiftedTime, etTz) * 10000 + month(globexShiftedTime, etTz) * 100 + dayofmonth(globexShiftedTime, etTz)
newGlobexDay = globexDayKey != globexDayKey[1]
newWeek = newGlobexDay and dayofweek(globexShiftedTime, etTz) == dayofweek.monday

var float nyPV = 0.0
var float nyV = 0.0
if newRthDay
    nyPV := 0.0
    nyV := 0.0
if inRth
    nyPV += hlc3 * volume
    nyV += volume
nyVwap = nyV > 0 ? nyPV / nyV : na

var float dayPV = 0.0
var float dayV = 0.0
if newGlobexDay
    dayPV := 0.0
    dayV := 0.0
dayPV += hlc3 * volume
dayV += volume
dailyVwap = dayV > 0 ? dayPV / dayV : na

var float wkPV = 0.0
var float wkV = 0.0
if newWeek
    wkPV := 0.0
    wkV := 0.0
wkPV += hlc3 * volume
wkV += volume
weeklyVwap = wkV > 0 ? wkPV / wkV : na

plot(showVwapNy and isIntraday ? nyVwap : na, "NY session VWAP", color = vwapNyColor, linewidth = 1)
plot(showVwapDaily ? dailyVwap : na, "Daily VWAP", color = vwapDailyColor, linewidth = 1)
plot(showVwapWeekly ? weeklyVwap : na, "Weekly VWAP", color = vwapWeeklyColor, linewidth = 1)

// ═══════════════════════════════════════════════════════════════════════════════════
// Period H/L — full ETH day, calendar week/month (ADR-0009). Line objects (not plot())
// so Low can be dashed; redraws (old deleted, new created) only when the underlying
// value actually changes, and extends full chart width.
// ═══════════════════════════════════════════════════════════════════════════════════
extTicker = ticker.new(syminfo.prefix, syminfo.ticker, session.extended)

[pdHigh, pdLow] = request.security(extTicker, "1D", [high[1], low[1]], lookahead = barmerge.lookahead_off)
[pwHigh, pwLow] = request.security(extTicker, "1W", [high[1], low[1]], lookahead = barmerge.lookahead_off)
[pmHigh, pmLow] = request.security(extTicker, "1M", [high[1], low[1]], lookahead = barmerge.lookahead_off)

drawPeriodLevel(active, val, lbl, col, styleStr, xOffset) =>
    var float lastVal = na
    var line ln = na
    var label lb = na
    if active and not na(val)
        // na(lastVal) first: on the bar a level goes from na to its first real value, the
        // bare `val != lastVal` compares against na, and na-propagating comparisons are not
        // reliably true — the level would silently never get a line. Matters most for the
        // VA levels, which sit na for the whole chart until the first session close.
        if na(lastVal) or val != lastVal
            lastVal := val
            line.delete(ln)
            label.delete(lb)
            ln := line.new(bar_index - 1, val, bar_index, val, color = col, width = 1, style = styleFromStr(styleStr), extend = extend.both)
            if showLabels
                lb := label.new(bar_index + xOffset, val, lbl + " " + str.tostring(val, format.mintick), style = label.style_label_left,
                     textcolor = col, color = color.new(color.black, 100), size = labelSize)
        line.set_y1(ln, val)
        line.set_y2(ln, val)
        line.set_style(ln, styleFromStr(styleStr))
        if showLabels
            label.set_xy(lb, bar_index + xOffset, val)
            label.set_text(lb, lbl + " " + str.tostring(val, format.mintick))

drawPeriodLevel(showPdhl, pdHigh, "PDH", pdhColor, highStyle, periodLabelOffset)
drawPeriodLevel(showPdhl, pdLow, "PDL", pdlColor, lowStyle, periodLabelOffset)
drawPeriodLevel(showPwhl, pwHigh, "PWH", pwhColor, highStyle, periodLabelOffset - 1)
drawPeriodLevel(showPwhl, pwLow, "PWL", pwlColor, lowStyle, periodLabelOffset - 1)
drawPeriodLevel(showPmhl, pmHigh, "PMH", pmhColor, highStyle, periodLabelOffset - 2)
drawPeriodLevel(showPmhl, pmLow, "PML", pmlColor, lowStyle, periodLabelOffset - 2)

// ═══════════════════════════════════════════════════════════════════════════════════
// Value Area — prior-session VAH/VAL/POC, auto-computed (ADR-0012). Volume histogram
// from 1m intrabars, each bar's volume split evenly across the tick-bins its range
// covers; frozen at the session close and drawn full-width until the next close, so
// one computation serves both the Asia evening and the next NY morning, and Friday's
// values carry through Sunday evening with no weekend special-casing. Lands within a
// few ticks of TradingView's native fixed-range VP, not tick-exact. Intrabar data caps
// at ~100k 1m bars (~2-3 months), so lines only render on recent history; window edges
// quantize to chart bars, so prefer <=30m charts for exact values.
// ═══════════════════════════════════════════════════════════════════════════════════
vaLtf = timeframe.in_seconds() >= 60 ? "1" : timeframe.period
[vaLtfHi, vaLtfLo, vaLtfVol] = request.security_lower_tf(syminfo.tickerid, vaLtf, [high, low, volume])

var vaBins = map.new<int, float>()
var float vahVal = na
var float valVal = na
var float pocVal = na
vaBinSize = vaBinTicks * syminfo.mintick

vaCompute() =>
    keys = vaBins.keys()
    int minK = na
    int maxK = na
    float total = 0.0
    for i = 0 to array.size(keys) - 1
        int k = array.get(keys, i)
        total += vaBins.get(k)
        if na(minK) or k < minK
            minK := k
        if na(maxK) or k > maxK
            maxK := k
    // POC: the max-volume bin; ties resolve toward the session midpoint (native-VP convention)
    float midK = (minK + maxK) / 2.0
    int pocK = minK
    float best = -1.0
    for k = minK to maxK
        float v = vaBins.contains(k) ? vaBins.get(k) : 0.0
        if v > best or (v == best and math.abs(k - midK) < math.abs(pocK - midK))
            best := v
            pocK := k
    // Standard expansion: absorb the bigger neighboring bin until vaPct% of volume is inside
    float acc = best
    int upK = pocK
    int dnK = pocK
    float target = total * vaPct / 100.0
    while acc < target and (upK < maxK or dnK > minK)
        float upV = upK < maxK ? (vaBins.contains(upK + 1) ? vaBins.get(upK + 1) : 0.0) : -1.0
        float dnV = dnK > minK ? (vaBins.contains(dnK - 1) ? vaBins.get(dnK - 1) : 0.0) : -1.0
        if upV >= dnV
            upK += 1
            acc += upV
        else
            dnK -= 1
            acc += dnV
    [(pocK + 0.5) * vaBinSize, (upK + 1) * vaBinSize, dnK * vaBinSize]

inVaWin = not na(time(timeframe.period, vaWindow + ":1234567", etTz))
// Freeze on the bar after the window ends (16:00 for the RTH default) — or, for windows
// that abut the next session across the 17:00-18:00 halt, on the first bar of the new
// Globex day.
vaNewSes = inVaWin and (not inVaWin[1] or newGlobexDay)
vaFreeze = (not inVaWin and inVaWin[1]) or vaNewSes

if vaFreeze and vaBins.size() > 0
    [p, vh, vl] = vaCompute()
    pocVal := p
    vahVal := vh
    valVal := vl
    vaBins.clear()

if showVa and inVaWin and not na(vaLtfVol) and array.size(vaLtfVol) > 0
    for i = 0 to array.size(vaLtfVol) - 1
        float v = array.get(vaLtfVol, i)
        if v > 0
            int loK = int(math.floor(array.get(vaLtfLo, i) / vaBinSize))
            int hiK = int(math.floor(array.get(vaLtfHi, i) / vaBinSize))
            float share = v / (hiK - loK + 1)
            for k = loK to hiK
                vaBins.put(k, (vaBins.contains(k) ? vaBins.get(k) : 0.0) + share)

drawPeriodLevel(showVa and vaShowVah, vahVal, "VAH", vahColor, highStyle, vaLabelOffset)
drawPeriodLevel(showVa and vaShowVal, valVal, "VAL", valColor, lowStyle, vaLabelOffset)
drawPeriodLevel(showVa and vaShowPoc, pocVal, "POC", pocColor, midStyle, vaLabelOffset - 1)

// Data Window readout for the VA pipeline. Nothing renders on the chart (display.data_window
// only) — these exist so the frozen values are readable as numbers, and so a missing line can
// be told apart from a missing computation: `VA bins` counts the histogram buckets filling
// during the profile session, `VA intrabars` is how many 1m bars request.security_lower_tf
// handed back on this chart bar (0 across the board = no intrabar data, not a drawing bug).
plot(vahVal, "VAH (value)", display = display.data_window)
plot(valVal, "VAL (value)", display = display.data_window)
plot(pocVal, "POC (value)", display = display.data_window)
plot(pdHigh, "PDH (value)", display = display.data_window)
plot(vaBins.size(), "VA bins", display = display.data_window)
plot(na(vaLtfVol) ? 0 : array.size(vaLtfVol), "VA intrabars", display = display.data_window)
plot(inVaWin ? 1 : 0, "VA in-window", display = display.data_window)

// ═══════════════════════════════════════════════════════════════════════════════════
// Session H/L — Overnight / Asia / London (windows shared with the sim)
// ═══════════════════════════════════════════════════════════════════════════════════
drawSessionHL(active, windowStr, lbl, hiColor, loColor, xOffset) =>
    var float hi = na
    var float lo = na
    var line hiLine = na
    var line loLine = na
    var label hiLabel = na
    var label loLabel = na

    if active
        inWin = not na(time(timeframe.period, windowStr + ":1234567", etTz))
        newWin = inWin and not inWin[1]
        endedWin = inWin[1] and not inWin

        if newWin
            hi := high
            lo := low
        else if inWin
            hi := math.max(hi, high)
            lo := math.min(lo, low)

        if endedWin
            line.delete(hiLine)
            line.delete(loLine)
            label.delete(hiLabel)
            label.delete(loLabel)
            hiLine := line.new(bar_index - 1, hi, bar_index, hi, color = hiColor, width = 1, style = resolveStyle(highStyle, false), extend = extend.both)
            loLine := line.new(bar_index - 1, lo, bar_index, lo, color = loColor, width = 1, style = resolveStyle(lowStyle, false), extend = extend.both)
            if showLabels
                hiLabel := label.new(bar_index + xOffset, hi, lbl + " H", style = label.style_label_left,
                     textcolor = hiColor, color = color.new(color.black, 100), size = labelSize)
                loLabel := label.new(bar_index + xOffset, lo, lbl + " L", style = label.style_label_left,
                     textcolor = loColor, color = color.new(color.black, 100), size = labelSize)

        if not na(hiLine)
            line.set_y1(hiLine, hi)
            line.set_y2(hiLine, hi)
            line.set_y1(loLine, lo)
            line.set_y2(loLine, lo)
            if showLabels
                label.set_xy(hiLabel, bar_index + xOffset, hi)
                label.set_text(hiLabel, lbl + " H " + str.tostring(hi, format.mintick))
                label.set_xy(loLabel, bar_index + xOffset, lo)
                label.set_text(loLabel, lbl + " L " + str.tostring(lo, format.mintick))

drawSessionHL(showOn and isIntraday, onWindow, "ON", onHighColor, onLowColor, sessionLabelOffset)
drawSessionHL(showAsia and isIntraday, asiaWindow, "Asia", asiaHighColor, asiaLowColor, sessionLabelOffset - 1)
drawSessionHL(showLondon and isIntraday, londonWindow, "London", londonHighColor, londonLowColor, sessionLabelOffset - 2)
